@article{liu2026unequalweight,
  abbr             = {JMP},
  title            = {The Unequal Weight of Genes: How Early-Life Environments Modify the Effects of Genetic Predispositions},
  author           = {Liu, Shutian},
  year             = {2026},
  note             = {Job Market Paper},
  abstract         = {Children from poorer families show a stronger link between genetic predictors and body weight. The dominant interpretation is that disadvantaged environments amplify children's own genetic risk for obesity. Previous research has relied on standard polygenic indices, which conflate the child's directly inherited genetic effects with the effects of parents' genotypes operating through the household environment, and thus has been unable to disentangle the two channels. I use linked parent--child genotypes from 5,446 children in the UK Millennium Cohort Study to compare a standard polygenic index for body mass index (from a 700,000-individual population GWAS) with a direct-effects polygenic index (from an 82,000-family GWAS that isolates inherited variation). The standard index reproduces the documented socioeconomic gradient; the direct-effects index's gradient is statistically indistinguishable from zero. The gradient is thus carried by the standard index and not by the direct-effects index. The paper makes three contributions. First, it introduces the Standard-versus-DGE design for separating direct-effect moderation (H1) from family-channel moderation (H2) within a single sample. Second, it establishes that the widely cited interpretation of the BMI gradient---that disadvantage amplifies children's own genetic risk---is not supported by the evidence: the gradient is equally consistent with a family-channel reading, and a formal restriction test cannot distinguish the two. Third, it identifies precisely why the design cannot yet decide between them, and turns that into a result the field needs as family-GWAS indices come into use: at currently available discovery sizes a family-GWAS index predicts the outcome too weakly to separate the channels, so a null direct-effects interaction is not evidence that environments leave children's own genetic risk untouched. Applying the same comparison to smoking yields a null for both indices, confirming that the BMI gradient is a real, trait-specific phenomenon and not an artefact of the design. Whether disadvantage amplifies children's own genetic risk---and hence whether genetic screening of children has any rationale---is therefore an open question with a clear data requirement: a substantially larger family GWAS.},
  pdf              = {https://github.com/ShutianLiuinfinite/gbye-mcs-bmises-public/blob/main/paper.pdf},
  selected         = {true},
  bibtex_show      = {true}
}

@article{liu2026cyberbullying,
  title            = {Lower Endowment, Heavier Toll: Polygenic Moderation of the Cyberbullying--Mental-Health Gradient in Adolescence},
  author           = {Liu, Shutian},
  year             = {2026},
  note             = {Working paper},
  abstract         = {Adolescent mental health in Europe is deteriorating, and the cross-sectional relationship between cyberbullying and adolescent mental health is widely documented. Public health discussions treat this relationship as uniform across adolescents, but the conditional association may vary systematically with adolescents' genetic predispositions. This project asks whether the age-17 SDQ--cyberbullying association in the Millennium Cohort Study varies with the cohort member's polygenic index for educational attainment. I estimate gene-by-environment specifications on a both-parents-genotyped trio sample, with mother's and father's edu PGI, value-added controls, and parental mental health as covariates. The PGI moderation parameter is identified within-family via random meiotic-draw variation in the cohort member's PGI conditional on both parents' PGI. Preliminary results indicate that the conditional SDQ--cyberbullying association is roughly three times steeper at the bottom of the polygenic-index distribution than at the top, with the gradient concentrated among girls and steeper in emotional and peer subscales than in conduct or hyperactivity.},
  selected         = {true},
  bibtex_show      = {true}
}

